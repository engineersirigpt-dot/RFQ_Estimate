<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Estimate Packaging</title>
    <!-- Bootstrap CSS -->
    <link href="./css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="./js/library/fontawesome/css/all.min.css" />

    <!-- jQuery -->
    <script src="./js/library/jquery-3.5.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="./js/library/bootstrap.bundle.min.js"></script>
    <script src="./js/library/axios.min.js"></script>

    <style>
      body {
        background: linear-gradient(
          135deg,
          #f8f9fa 0%,
          #e9ecef 50%,
          #dee2e6 100%
        );
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 20px;
        box-sizing: border-box;
      }

      .login-container {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        padding: 3rem;
        width: 100%;
        max-width: 400px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }

      .login-header {
        text-align: center;
        margin-bottom: 2rem;
      }

      .login-header h2 {
        color: #333;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      .login-header p {
        color: #666;
        font-size: 0.9rem;
      }
      /* 
      .form-floating {
        margin-bottom: 1.5rem;
      } */

      .form-control {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 1rem 0.75rem;
        transition: all 0.3s ease;
      }

      .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
      }

      .btn-login {
        background: linear-gradient(135deg, #0d6efd 0%, #0056b3 100%);
        border: none;
        border-radius: 10px;
        padding: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        width: 100%;
        color: white;
      }

      .btn-login:hover {
        background: linear-gradient(135deg, #0056b3 0%, #004085 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(13, 110, 253, 0.3);
        color: white;
      }

      .btn-login:active {
        transform: translateY(0);
      }

      .input-group-text {
        background: transparent;
        border: 2px solid #e9ecef;
        border-right: none;
        border-radius: 10px 0 0 10px;
      }

      .input-group .form-control {
        border-left: none;
        border-radius: 0 10px 10px 0;
      }

      .login-footer {
        text-align: center;
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #e9ecef;
      }

      .alert {
        border-radius: 10px;
        margin-bottom: 1rem;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .login-container {
        animation: fadeIn 0.6s ease-out;
      }
    </style>

    <script>
      const hostname = window.location.hostname;
      const api_url = "<%= data.api_url %>".replace("hostname", hostname);
      const node_api = window.location.origin;
      const base_url = "<%= data.base_url %>".replace("hostname", hostname);

      document.write(`<base href=${base_url}>`);
      console.log(`
        api_url : ${api_url},
        base_url : ${base_url}
        host_name : ${hostname}
    `);
    </script>
  </head>
  <body>
    <div class="container d-flex justify-content-center">
      <div class="login-container">
        <div class="login-header">
          <h2><i class="fas fa-lock text-primary"></i> เข้าสู่ระบบ</h2>
        </div>

        <!-- Alert สำหรับแสดงข้อความ -->
        <div id="alertMessage" class="alert alert-danger d-none" role="alert">
          <i class="fas fa-exclamation-triangle"></i>
          <span id="alertText"></span>
        </div>

        <form id="loginForm">
          <!-- Username Field -->
          <div class="input-group mb-3">
            <span class="input-group-text">
              <i class="fas fa-user text-muted"></i>
            </span>
            <div class="form-floating">
              <input
                type="text"
                class="form-control"
                id="username"
                placeholder="Username"
                required
              />
              <label for="username">ชื่อผู้ใช้</label>
            </div>
          </div>

          <!-- Password Field -->
          <div class="input-group mb-4">
            <span class="input-group-text">
              <i class="fas fa-lock text-muted"></i>
            </span>
            <div class="form-floating">
              <input
                type="password"
                class="form-control"
                id="password"
                placeholder="Password"
                required
              />
              <label for="password">รหัสผ่าน</label>
            </div>
            <button
              class="btn btn-outline-secondary"
              type="button"
              id="togglePassword"
            >
              <i class="fas fa-eye"></i>
            </button>
          </div>

          <!-- Login Button -->
          <button type="submit" class="btn btn-primary btn-login">
            <i class="fas fa-sign-in-alt me-2"></i>เข้าสู่ระบบ
          </button>
        </form>
      </div>
    </div>

    <script>
      $(document).ready(function () {
        localStorage.removeItem("user");
        // ฟังก์ชันแสดง/ซ่อนรหัสผ่าน
        $("#togglePassword").click(function () {
          const passwordField = $("#password");
          const type =
            passwordField.attr("type") === "password" ? "text" : "password";
          passwordField.attr("type", type);

          // เปลี่ยนไอคอน
          const icon = $(this).find("i");
          if (type === "password") {
            icon.removeClass("fa-eye-slash").addClass("fa-eye");
          } else {
            icon.removeClass("fa-eye").addClass("fa-eye-slash");
          }
        });

        // ฟังก์ชันแสดงข้อความแจ้งเตือน
        function showAlert(message, type = "danger") {
          const alertDiv = $("#alertMessage");
          const alertText = $("#alertText");

          alertDiv
            .removeClass("alert-danger alert-success alert-warning")
            .addClass(`alert-${type}`)
            .removeClass("d-none");
          alertText.text(message);

          // ซ่อนข้อความหลัง 5 วินาที
          setTimeout(function () {
            alertDiv.addClass("d-none");
          }, 5000);
        }

        // ฟังก์ชันจัดการการ submit form
        $("#loginForm").submit(async function (e) {
          e.preventDefault(); // ป้องกันการ submit form แบบปกติ

          const username = $("#username").val().trim();
          const password = $("#password").val().trim();

          // ตรวจสอบข้อมูล
          if (username === "") {
            showAlert("กรุณากรอกชื่อผู้ใช้", "warning");
            $("#username").focus();
            return false;
          }

          if (password === "") {
            showAlert("กรุณากรอกรหัสผ่าน", "warning");
            $("#password").focus();
            return false;
          }

          // ปิดการใช้งานปุ่มชั่วคราว
          const loginBtn = $(".btn-login");
          const originalText = loginBtn.html();
          loginBtn
            .prop("disabled", true)
            .html(
              '<i class="fas fa-spinner fa-spin me-2"></i>กำลังเข้าสู่ระบบ...'
            );

          // ส่งข้อมูลไปยัง server
          await axios
            .post(
              `${node_api}/user/login`,
              { username, password },
              {
                headers: {
                  "Content-Type": "application/json",
                },
              }
            )
            // .then((response) => response.json())
            .then(async ({ data: respData }) => {
              console.log("login res:", respData);
              const { user, success, accessToken, refreshToken } =
                respData || {};

              // localStorage.setItem("user", JSON.stringify(res.user));

              if (success) {
                const checkAuth = user?.roles?.some((role) => role.authorized) || user?.isPassed === 0;
                if (checkAuth) {
                  const { roles, data: emp_data, username } = user || {};
                  const { emp_id: _emp_id, emp_name: _emp_name } = emp_data?.[0] || {};
                  const emp_id = _emp_id || username;
                  const emp_name = _emp_name || username;

                  const { data: cookieResp } = await axios.post(
                    `${base_url}/set-cookie`,
                    {
                      emp_id,
                      accessToken,
                      refreshToken,
                    }
                  );

                  console.log("cookieResp", cookieResp);

                  if (cookieResp?.success) {
                    const data = {
                      emp_id,
                      emp_name,
                      roles,
                      user_group_id: roles?.map((role) => role.user_group_id),
                      sale_group_id: roles?.map((role) => role.sale_group_id),
                      enable_price_check: roles?.some(
                        (role) => role.enable_price_check
                      ),
                      is_super_admin: roles?.some((role) => role.is_super_admin),
                    };

                    localStorage.setItem("data", JSON.stringify(data));
                    var url = localStorage.getItem("url");
                    console.log("url", url);

                    showAlert("เข้าสู่ระบบสำเร็จ!", "success");

                    setTimeout(function () {
                      if (url) {
                        console.log("case1");
                        window.location = "/" + url;
                      } else {
                        console.log("case2");
                        window.location = "/";
                      }
                    }, 500);
                  }
                }
              } else {
                showAlert("Username หรือ Password ไม่ถูกต้อง", "danger");
                $("#password").val("").focus(); // ล้างรหัสผ่านและโฟกัส
              }
            })
            .catch((error) => {
              console.error("Error:", error);
              showAlert("เกิดข้อผิดพลาดในการเชื่อมต่อกับเซิร์ฟเวอร์", "danger");
            });

          loginBtn.prop("disabled", false).html(originalText);
        });

        // เอฟเฟกต์เมื่อกดปุ่ม Enter
        $("#username, #password").keypress(function (e) {
          if (e.which === 13) {
            // กด Enter
            $("#loginForm").submit();
          }
        });

        // เอฟเฟกต์ focus input
        $(".form-control")
          .focus(function () {
            $(this).parent().parent().addClass("focused");
          })
          .blur(function () {
            $(this).parent().parent().removeClass("focused");
          });
      });
    </script>
  </body>
</html>
