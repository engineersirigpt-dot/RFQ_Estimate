  <body>
    <div id="estimate_form">
      <div class="loading">
        <div>
          <div class="loader"></div>
          <h2 class="loader-message"></h2>
        </div>
      </div>
      <div class="estimate-header">
        <h1 id="jobInfo" class="position-relative" style="margin-left: 30px">
          <div>Estimate Packaging</div>
        </h1>
        <div id="flex-menu">
          <div id="home-bttn" class="child-menu position-relative">
            <i class="fa fa-home" style="font-size: 30px"></i
            >&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;RFQ Search
          </div>
          <!-- <div id="view-wizard" class="child-menu">
            <img
              src="./img/magic-wand.png"
              alt=""
              style="width: 18px; height: 18px"
            />
            Wizard
          </div> -->
          <div id="job-info-bttn" class="child-menu">ข้อมูล Job</div>
          <div id="spec-info-bttn" class="child-menu">Spec</div>
          <div
            id="layout-bttn"
            class="child-menu"
            id="layout-bttn"
            style="display: none"
          >
            Layout
          </div>
          <div
            id="summary-bttn"
            class="child-menu"
            id="summary-bttn"
            style="display: none"
          >
            Summary
          </div>
          <div id="right-menu">
            <!-- <div id="excel-bttn" style="display:none;"><button tableexport-id="18a3ec26-xlsx" style="font-size:16px">Excel</button></div> -->
            <div id="save-bttn" style="display: none">Save RFQ</div>
            <div id="print-bttn" style="width: 80px; text-align: center">
              Print
            </div>
            <div
              id="print"
              style="width: 80px; text-align: center; display: none"
            >
              PDF
            </div>
            <div id="login-bttn" style="text-align: center">
              Log in as guest
            </div>
            <div id="logout-bttn" style="text-align: center">
              <i class="fa fa-sign-out" style="font-size: 25px"></i>
            </div>
          </div>
        </div>
      </div>
      <div id="inputInfo">
        <div id="job_info">
          <div class="ml-1">
            <b>Last Updated :</b> <span id="updated_by">-</span>
          </div>
          <table cellspacing="8">
            <tr>
              <td>
                <span class="bold">Ref Copy. ID</span>
              </td>
              <td>
                <div class="w-lg">
                  <span id="ref_copy_rfq">-</span>
                </div>
              </td>
              <td class="text-center">
                <span class="bold"> Created By </span>
              </td>
              <td colspan="3">
                <div class="w-xl">
                  <span id="created_by">-</span>
                </div>
              </td>
              <td>
                <span class="bold">Date</span>
              </td>
              <td>
                <div id="date">
                  <input
                    id="date"
                    class="required text-rightd datepicker"
                    type="text"
                    placeholder="dd/mm/yyyy"
                    style="width: 130px; text-align: center"
                    readonly
                  />
                </div>
              </td>
              <td colspan="2" style="min-width: 275px">
                <div style="z-index: 4; position: relative">
                  <input
                    id="is_estimate_checked"
                    type="checkbox"
                    class="d-none"
                  />
                  <label for="status_id" class="bold mr-1"
                    >Document Status</label
                  >
                  <select
                    id="status_id"
                    class="text-center w-md3 mr-1"
                  ></select>
                  <span id="rejectRemarkLabel" class="warning bold btn">
                    <u>Remark</u>
                  </span>
                  <span id="approve_checked" class="estimate_check d-none"
                    >ตรวจสอบราคาแล้ว</span
                  >
                </div>
              </td>
            </tr>
            <tr>
              <td colspan="10">
                <hr />
              </td>
            </tr>
            <tr>
              <td><b>RFQ ID</b></td>
              <td style="width: 110px">
                <div id="rfqID">
                  <input class="w-100" style="min-width: 80px" readonly />
                </div>
              </td>
              <td style="display: none; width: 110px">
                <div id="refCopyID"><input readonly /></div>
              </td>
              <td style="text-align: center">
                <b>AE Name</b><strong style="color: red">*</strong>
              </td>
              <td colspan="3">
                <div id="div-ae">
                  <input id="aeID" type="hidden" />
                  <input id="aeName" type="hidden" />
                  <input
                    id="aeLabel"
                    class="required"
                    style="width: 218px"
                    onKeyup="autocomplete_employee(this,'ae');"
                    autocomplete="off"
                  />
                  <div id="snackbar-ae" class="snackbar">
                    Please fill AE name
                  </div>
                </div>
              </td>
              <td style="text-align: center"><b>Estimator</b></td>
              <td colspan="3">
                <div>
                  <input id="estID" type="hidden" />
                  <input id="estName" type="hidden" />
                  <input id="estLabel" style="width: 200px" readonly />
                  <input type="checkbox" id="request_for_approve" />
                  <label for="request_for_approve">Request for approve</label>
                </div>
              </td>
            </tr>
            <tr>
              <td><b>Job Name</b><strong style="color: red">*</strong></td>
              <td colspan="9">
                <div id="jobName">
                  <input class="required" style="width: 100%" />
                </div>
              </td>
            </tr>
            <tr>
              <td><b>Customer</b><strong style="color: red">*</strong></td>
              <td colspan="11">
                <div id="div-customer">
                  <input id="custID" type="hidden" />
                  <input id="custName" type="hidden" />
                  <input
                    id="customerLabel"
                    class="required"
                    style="width: 300px"
                  />
                  <input type="checkbox" id="is_newCustomer" />
                  <span class="mr-2">ลูกค้าใหม่</span>
                  <input type="hidden" id="credit_term_id" />
                  <span id="credit_term_desc">
                    <b>Credit Term :</b>
                    <span id="credit_term_name">-- ไม่พบข้อมูล --</span>
                  </span>
                  <div id="snackbar-customer" class="snackbar">
                    Please fill customer
                  </div>
                </div>
              </td>
            </tr>
            <tr>
              <td colspan="6">
                <input type="checkbox" id="is_multiple_f" /> <b>งานมีหลาย F</b>
              </td>
            </tr>
          </table>
        </div>
        <!-- <div class="mt-1 mb-1 ml-1">
				
			</div> -->
        <div id="qty_info">
          <div id="add-remove-qty-bttn">
            <table>
              <tr>
                <td>
                  <button id="addQty" type="button">
                    เพิ่ม จำนวนยอด (Quantity)
                  </button>
                </td>
                <td style="text-align: center">
                  <button id="removeQty" type="button">
                    ลด จำนวนยอด (Quantity)
                  </button>
                </td>
              </tr>
            </table>
          </div>
          <div id="qtyInput">
            <table cellspacing="8">
              <tr>
                <td>Quantity<strong style="color: red">*</strong></td>
                <td style="width: 100px; text-align: center">
                  <div class="inputQty">
                    <input
                      class="required"
                      style="width: 60px; text-align: center"
                      value=""
                    />
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  Run-On
                  <input
                    style="width: 20px; text-align: center"
                    class="runonPercent"
                  />
                  %
                </td>
                <td style="width: 100px; text-align: center">
                  <div class="runonQty">
                    <input style="width: 60px; text-align: center" />
                  </div>
                </td>
              </tr>
              <tr>
                <td>AE Qty</td>
                <td style="width: 100px; text-align: center">
                  <div class="aeQty">
                    <input style="width: 60px; text-align: center" />
                  </div>
                </td>
                <td style="text-align: center">Customer Qty</td>
                <td style="width: 100px; text-align: center">
                  <div class="customerQty">
                    <input style="width: 60px; text-align: center" />
                  </div>
                </td>
              </tr>
            </table>
          </div>
        </div>

        <div id="multiple_f_qty_info" class="d-none mt-1 mb-2">
          <div id="add-remove-qty-bttn">
            <table>
              <tr>
                <td>
                  <button id="addFQty" type="button">เพิ่ม จำนวน F</button>
                </td>
                <td style="text-align: center">
                  <button id="removeFQty" type="button">ลด จำนวน F</button>
                </td>
              </tr>
            </table>
          </div>
          <div id="qtyInput" class="f_qtyInput">
            <div class="d-flex flex-row f-container">
              <table cellspacing="8" class="f_table" style="width: 250px">
                <tr>
                  <td colspan="2">
                    <input placeholder="F Code" class="f-code required w-100" />
                  </td>
                </tr>
                <tr>
                  <td>Quantity<strong style="color: red">*</strong></td>
                  <td style="width: 100px; text-align: center">
                    <div class="inputQty">
                      <input
                        class="required"
                        style="width: 60px; text-align: center"
                        value=""
                      />
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>
                    Run-On
                    <input
                      style="width: 20px; text-align: center"
                      class="runonPercent"
                    />
                    %
                  </td>
                  <td style="width: 100px; text-align: center">
                    <div class="runonQty">
                      <input style="width: 60px; text-align: center" />
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>AE Qty</td>
                  <td style="width: 100px; text-align: center">
                    <div class="aeQty">
                      <input style="width: 60px; text-align: center" />
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>Customer Qty</td>
                  <td style="width: 100px; text-align: center">
                    <div class="customerQty">
                      <input style="width: 60px; text-align: center" />
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>Total Qty.</td>
                  <td style="width: 100px; text-align: center">
                    <div class="f-totalQty">
                      <input
                        readonly
                        style="width: 60px; text-align: center"
                        value=""
                      />
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>
                    ลิมิตสี <input class="chk_color_limit" type="checkbox" />
                  </td>
                  <td
                    class="color_limit color_limit_f"
                    style="display: none; text-align: center"
                  >
                    <input
                      class="required"
                      style="width: 60px; text-align: center"
                      placeholder="เล่ม"
                    />
                  </td>
                </tr>
              </table>
            </div>
          </div>
          <div>
            <table>
              <tr>
                <td>Total Qty.</td>
                <td>
                  <input
                    class="f-sumTotalQty"
                    readonly
                    style="width: 80px; text-align: center"
                    value=""
                  />
                </td>
              </tr>
            </table>
          </div>
        </div>

        <div id="add-remove-component-bttn">
          <table cellspacing="8">
            <tr>
              <td>
                <button id="addComp" type="button">
                  เพิ่ม ชิ้นส่วน (Component)
                </button>
              </td>
              <td style="text-align: center">
                <button id="removeComp" type="button">
                  ลด ชิ้นส่วน (Component)
                </button>
              </td>
            </tr>
          </table>
        </div>
        <div id="job_detail">
          <table cellpadding="5px" style="margin: 5px">
            <tr>
              <td style="width: 80px">ประเภทงาน :</td>
              <td id="is_reprinted" style="width: 120px">
                <select style="text-align-last: center">
                  <option value="0">งานใหม่</option>
                  <option value="1">งาน Reprint</option>
                </select>
              </td>
              <td style="width: 80px">ประเภทหมึก :</td>
              <td id="ink_type" style="width: 80px">
                <select style="text-align-last: center">
                  <option value="conventional">ธรรมดา</option>
                  <option value="UV">UV</option>
                </select>
              </td>

              <td style="width: 80px">ประเภทพิมพ์ :</td>
              <td id="print_type" style="width: 70px">
                <select style="text-align-last: center">
                  <option value="Offset">Offset</option>
                  <option value="Flexo">Flexo</option>
                  <option value="Jet Press">Jet Press</option>
                  <option value="Konica">Konica</option>
                </select>
              </td>

              <td id="flexo_size" style="display: none">
                Size (in²)
                <input
                  class="required"
                  style="width: 45px; text-align: center"
                />
                x
                <input
                  class="required"
                  style="width: 45px; text-align: center"
                />
              </td>
              <td
                style="width: 80px; text-align: right"
                class="color_limit_normal"
              >
                <input class="chk_color_limit" type="checkbox" /> ลิมิตสี
              </td>
              <td class="color_limit color_limit_normal" style="display: none">
                <input
                  class="required"
                  style="width: 70px; text-align: center"
                />
                เล่ม
              </td>
              <td
                style="width: 120px; text-align: right"
                class="use_prev_plate d-none"
              >
                <input id="is_use_previous_plate" type="checkbox" /> ใช้ Plate
                เก่า
              </td>
              <td style="text-align: right" class="profit_sharing">
                <input class="chk_profit_sharing" type="checkbox" disabled />
                Profit Sharing
                <span class="warning"
                  >(ยกเลิกใช้งาน มีผลตั้งแต่ 03/01/2025 เป็นต้นไป)</span
                >
              </td>
            </tr>
          </table>
        </div>
        <div id="component">
          <div class="component" index="0">
            <div class="componentSpec flex-row" index="0" style="margin: 5px">
              <div class="nameComponent w-100 mb-1" index="0">
                <div index="0">
                  <table cellspacing="8">
                    <tr>
                      <td colspan="3">
                        <h2 class="componentIndex">Component ที่ 1</h2>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <input
                          class="nameComp required"
                          style="text-align: center"
                          placeholder="Component name"
                          value=""
                        />
                      </td>
                      <td>
                        <select
                          class="componentType"
                          style="text-align-last: center"
                        >
                          <option value="1">ไม่ประกบลูกฟูก</option>
                          <option value="2">ประกบลูกฟูก</option>
                          <option value="3">เฉพาะลูกฟูก</option>
                        </select>
                      </td>
                      <td>
                        <div class="deleteComponent">ลบ</div>
                      </td>
                    </tr>
                  </table>
                </div>
              </div>

              <div index="0" class="detailComp">
                <div class="specialInkSection w-100 color-section" index="0">
                  <div class="section-description">
                    <b>- สี และสีพิเศษ</b>
                  </div>
                  <div class="component-color-section">
                    <div class="f-section w-100">
                      <div class="speicalInk-button d-flex flex-row">
                        <div class="addSpeInk-f speInk-btn">เพิ่ม</div>
                        <div class="deleteSpeInk-f speInk-btn ml-2">ลด</div>
                        <div class="copySpeInk-f speInk-btn ml-2">copy</div>
                      </div>
                    </div>
                    <div class="specialInk-list d-flex flex-row flex-wrap">
                      <div class="specialInk-container">
                        <table>
                          <tr>
                            <td style="text-align: center; width: 252px">
                              <div>
                                <select
                                  class="specialInkFCode f-code-select f-input required"
                                  style="text-align: center; width: 80%"
                                >
                                  <option value="">- F Code -</option>
                                </select>
                              </div>
                              <div class="group_check_special_ink">
                                <input
                                  class="has_speInk mt-1"
                                  type="checkbox"
                                  data-f_index="0"
                                />
                                มีสีพิเศษ
                              </div>
                            </td>
                            <td style="width: 303px">
                              <div index="0" class="ml-5">
                                <table cellspacing="8">
                                  <tr>
                                    <td class="d-flex align-center">
                                      <div
                                        class="group_check_black_printing on-konica d-flex align-center mr-1"
                                      >
                                        <input
                                          class="is_black_printing outside"
                                          data-color_side="outside"
                                          type="checkbox"
                                          data-f_index="0"
                                        />
                                        พิมพ์สีดำ
                                      </div>
                                      <div style="width: 80px">
                                        : Outside
                                        <strong style="color: red" class="mr-1"
                                          >*</strong
                                        >
                                      </div>
                                      <input
                                        class="colorOutside required mr-1"
                                        style="
                                          text-align: center;
                                          width: 20px;
                                          text-align: center;
                                        "
                                        value=""
                                      />
                                      cols
                                    </td>
                                  </tr>
                                  <tr>
                                    <td class="d-flex align-center">
                                      <div
                                        class="group_check_black_printing on-konica d-flex align-center mr-1"
                                      >
                                        <input
                                          class="is_black_printing inside"
                                          data-color_side="inside"
                                          type="checkbox"
                                          data-f_index="0"
                                        />
                                        พิมพ์สีดำ
                                      </div>
                                      <div style="width: 80px">
                                        : Inside
                                        <strong style="color: red" class="mr-1"
                                          >*</strong
                                        >
                                      </div>
                                      <input
                                        class="colorInside required mr-1"
                                        style="
                                          text-align: center;
                                          width: 20px;
                                          text-align: center;
                                        "
                                        value="0"
                                      />
                                      cols
                                    </td>
                                  </tr>
                                </table>
                              </div>
                            </td>
                          </tr>
                          <tr>
                            <td colspan="2">
                              <div
                                class="div-speInk"
                                index="0"
                                style="margin: 5px; display: none"
                                f_index="0"
                              >
                                <div>
                                  <table cellspacing="5px">
                                    <tr>
                                      <td style="width: 120px">
                                        <strong>Special Ink (สีพิเศษ)</strong>
                                      </td>
                                      <td>
                                        <div class="addSpeInk speInk-btn ml-1">
                                          เพิ่ม
                                        </div>
                                      </td>
                                    </tr>
                                  </table>
                                  <table
                                    cellspacing="5px"
                                    cellpadding="5px"
                                    class="table_speInk"
                                  >
                                    <thead>
                                      <th></th>
                                      <th>สี</th>
                                      <th>ชนิดหมึก</th>
                                      <th>ลักษณะการพิมพ์สี</th>
                                    </thead>
                                    <tbody></tbody>
                                  </table>
                                </div>
                              </div>
                            </td>
                          </tr>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="section paper-section">
                  <div class="section-description d-flex flex-row align-center">
                    <b>- ประเภทกระดาษ</b>
                    <div
                      class="paperMarkup"
                      style="margin: 5px; margin-left: 80px"
                      index="0"
                    >
                      <div>
                        mark-up
                        <input
                          class="required"
                          style="text-align: center; width: 60px"
                          value="7"
                        />
                        %
                      </div>
                    </div>
                  </div>
                  <div class="section-detail d-flex flex-wrap w-100">
                    <div index="0" class="paperInput">
                      <table cellspacing="8">
                        <tr>
                          <td style="text-align: center">
                            Paper<strong style="color: red">*</strong>
                          </td>
                          <td style="text-align: center" colspan="2">
                            <select
                              class="paperType required"
                              style="text-align-last: center; width: 100%"
                            >
                              <option value="">-select type-</option>
                            </select>
                            <span
                              class="paperCode-custom"
                              style="display: none"
                            ></span>
                            <span
                              class="paperType-custom"
                              style="display: none"
                            ></span>
                          </td>
                          <td style="text-align: center">
                            <select
                              class="paperGram required"
                              style="text-align-last: center"
                            >
                              <option value="">-</option>
                            </select>
                            <span
                              class="paperGram-custom"
                              style="display: none"
                            ></span>
                            <span
                              class="paperThickness-custom"
