    />

    <script src="./js/includes/config.js"></script>

    <script src="./js/data/default.js"></script>
    <script src="./js/data/mockup.js"></script>
    <script src="./js/function_estimate_calculation.js"></script>
    <script src="./js/function_estimate_readyFunction.js"></script>
