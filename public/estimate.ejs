          <table cellpadding="5px" style="margin: auto">
            <tr>
              <td>Layer</td>
              <td>
                <div>
                  <select
                    id="corrugated-layer-custom"
                    class="required"
                    style="width: 100px"
                  >
                    <option value="">- Select layer -</option>
                  </select>
                </div>
              </td>
            </tr>
            <tr>
              <td>ลอน</td>
              <td>
                <div>
                  <select
                    id="corrugated-flute-custom"
                    class="required"
                    style="width: 100px"
                  >
                    <option value="">-</option>
                  </select>
                  <span id="flute-custom" style="display: none">
                    <input
                      id="flute-info-custom"
                      class="required"
                      style="width: 30px"
                    />
                    ความหนา
                    <input
                      id="thickness-custom-p"
                      class="required"
                      style="width: 30px"
                    />
                    mm
                  </span>
                </div>
              </td>
            </tr>
            <tr>
              <td>Grade</td>
              <td>
                <div id="corrugated-grade-custom">
                  <input id="" class="required" style="width: 30px" />
                  <input id="" class="required" style="width: 30px" />
                  /
                  <input id="" class="required" style="width: 30px" />
                  <input id="" class="required" style="width: 30px" />
                </div>
              </td>
            </tr>
            <tr>
              <td>ราคา</td>
              <td>
                <div>
                  <input
                    id="corrugated-cost-custom"
                    class="required"
                    style="width: 50px"
                  />
                  <span id="unit-price">B/ตร.ฟุต</span>
                  <input type="checkbox" id="corrugated-bath-sheet" />
                  ราคา/แผ่น
                </div>
              </td>
            </tr>
            <tr id="corrugated-size-row" style="display: none">
              <td>Size</td>
              <td>
                <div>
                  ลอนขนานด้าน
                  <input
                    id="flute-side-custom"
                    class="required"
                    style="width: 45px"
                  />
                  x Cut off
                  <input
                    id="cut-off-custom"
                    class="required"
                    style="width: 45px"
                  />
                  นิ้ว
                </div>
              </td>
            </tr>
            <tr>
              <td colspan="4" style="text-align: center">
                <button id="corrugated-custom-save" style="width: 70px">
                  <i class="fa fa-check" style="font-size: 20px"></i></button
                >&nbsp;&nbsp;&nbsp;&nbsp;
                <button id="corrugated-custom-cancel" style="width: 70px">
                  <i class="fa fa-times" style="font-size: 20px"></i>
                </button>
              </td>
            </tr>
          </table>
        </div>
      </div>
      <div class="dev-tool-box">
        <div class="check-data-tool">
          <button id="mockup-est-data">Mockup Data แบ่ง F</button>
          <button id="mockup-est-data2">Mockup Data ปกติ</button>
          <!-- <button id="check-validate-data">Validate</button> -->
          <button id="reset-est-data">Reset</button>
          <button id="check-est-data">Check Data</button>
          <!-- <button id="print">Print</button> -->
          <!-- <button id="check-component-data">Check Component</button> -->
        </div>
      </div>
    </div>

    <!-- Modal -->
    <div class="modal-overlay" id="wizardModal">
      <div class="modal-container">
        <div class="modal-header">
          <h3><i class="fa fa-history mr-1 mb-2"></i>ประวัติการประเมินราคา</h3>
          <span class="modal-close" id="closeModal">X</span>
        </div>
        <div class="modal-search">
          <input
            type="text"
            id="searchInput"
            placeholder="ค้นหาจากชื่อ งาน ประเภทกล่อง หรือวันที่..."
          />
          <span id="create-wizard"><i class="fa fa-plus mr-1"></i> Wizard</span>
        </div>
        <div class="modal-list" id="modalList">
          <!-- รายการจะถูกเติมด้วย jQuery -->
        </div>
        <div class="modal-footer">
          <button id="closeBtn">ปิด</button>
        </div>
      </div>
    </div>

    <div id="view-only"></div>
  </body>
</html>
